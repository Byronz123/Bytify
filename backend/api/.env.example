PORT=8787
LOG_LEVEL=info

# ---------- Film & serial ----------
# Adapter dipisah titik koma: archive (Internet Archive, domain publik) dan/atau file (JSON kurasi).
MOVIE_PROVIDERS=archive
MOVIE_REFRESH_SECONDS=21600
# MOVIE_CATALOG_FILE=/data/catalog.json
ARCHIVE_MAX_MOVIES=60
ARCHIVE_MAX_SERIES=20
ARCHIVE_MAX_YEAR=1977
# MOVIE_BLOCKLIST=ia-contoh-id;ia-lain
# MOVIE_BLOCKED_TERMS=sex;nudity;erotic

# ---------- Live TV ----------
# URL playlist M3U HTTPS (atau path berkas) dari penyedia yang memberi izin distribusi.
LIVE_PLAYLIST_URLS=
# Isi true hanya setelah hak menampilkan kanal-kanal tersebut dipastikan.
LIVE_SOURCE_RIGHTS_CONFIRMED=false
LIVE_SOURCE_LICENSE_LABEL=
LIVE_SOURCE_REFRESH_SECONDS=300
LIVE_HEALTH_CHECK_SECONDS=120
LIVE_PROBE_TIMEOUT_MS=5000
LIVE_PROBE_CONCURRENCY=10
LIVE_MAX_CHANNELS=120
LIVE_DEFAULT_COUNTRY=ID
