PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Ganti PUBLIC_BASE_URL sesuai alamat yang diakses HP/Emulator:
# - Emulator Android Studio: http://10.0.2.2:8787
# - HP Fisik (Wi-Fi sama): http://192.168.1.XX:8787
PUBLIC_BASE_URL=http://10.0.2.2:8787

# ---------- Film & serial ----------
MOVIE_PROVIDERS=lk21;archive
MOVIE_REFRESH_SECONDS=21600
ARCHIVE_MAX_MOVIES=40
ARCHIVE_MAX_SERIES=15
ARCHIVE_MAX_YEAR=1977

# ---------- Konfigurasi LK21 & NontonDrama ----------
LK21_URL=https://tv15.lk21official.my
ND_URL=https://tv14.nontondrama.click
DL_URL=https://tv15.lk21official.my
LK21_API_BASE_URL=
LK21_MAX_PAGES=2
LK21_TIMEOUT_MS=15000
CACHE_FILE=./data/lk21-cache.json

# ---------- Live TV ----------
LIVE_PLAYLIST_URLS=
LIVE_XTREAM_URL=
LIVE_XTREAM_USERNAME=
LIVE_XTREAM_PASSWORD=
LIVE_XTREAM_FORMAT=
LIVE_SOURCE_RIGHTS_CONFIRMED=true
LIVE_SOURCE_LICENSE_LABEL=
LIVE_SOURCE_REFRESH_SECONDS=300
LIVE_HEALTH_CHECK_SECONDS=120
LIVE_PROBE_TIMEOUT_MS=5000
LIVE_PROBE_CONCURRENCY=10
LIVE_MAX_CHANNELS=120
LIVE_DEFAULT_COUNTRY=ID

# --- Subtitle (OpenSubtitles) ---------------------------------------------
# Dipakai oleh /api/subtitles, /api/subtitles/link, dan /api/subtitles/file.
#
# Kunci HANYA di sisi server. JANGAN pernah menaruhnya di APK atau di
# local.properties: APK bisa dibongkar (apktool, strings) dan kuncinya diambil.
#
# Daftar gratis: https://www.opensubtitles.com/consumers
#   1. Buat akun, lalu "New Consumer" untuk mendapat API key.
#   2. Baca ketentuan pemakaian API-nya.
#   3. Setel OPENSUBTITLES_TERMS_ACCEPTED=true untuk menyatakan sudah dibaca.
#      Tanpa itu endpoint subtitle menjawab 503 dan tidak menembak API.
#
# Di Cloudflare Pages, isi ketiganya di Settings -> Environment variables dan
# tandai kuncinya sebagai Secret (bukan plaintext).
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TERMS_ACCEPTED=false
# Wajib menyebut nama aplikasi; OpenSubtitles menolak User-Agent generik.
OPENSUBTITLES_APP_NAME=Bytify v1.0
# Bahasa yang diminta, urut prioritas. Maksimal 5.
SUBTITLE_LANGUAGES=id,en


# --- SubDL: sumber subtitle KEDUA ---
#
# Hanya menambal bahasa yang TIDAK dimiliki OpenSubtitles, dan itu yang membuat
# film Indonesia punya subtitle Indonesia: diukur, OpenSubtitles tidak punya
# satu berkas pun untuk rilis Indonesia baru (tmdb 1525059 dan 1589663 nol),
# sementara SubDL punya.
#
# Kunci gratis (1.000 permintaan/hari) didaftarkan sendiri di subdl.com —
# halamannya memakai captcha dan verifikasi email, jadi harus dikerjakan
# manusia. Tanpa kunci ini seluruh jalur SubDL DIAM dan hasilnya persis seperti
# sebelumnya; tidak ada yang rusak.
SUBDL_API_KEY=
SUBDL_BASE_URL=https://api.subdl.com
SUBDL_DOWNLOAD_URL=https://dl.subdl.com
