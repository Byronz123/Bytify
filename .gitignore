.gradle/
build/
app/build/
backend/api/dist/
local.properties
.idea/
*.iml
.kotlin/

# Python bytecode cache
__pycache__/
*.pyc

# Hasil scraping mentah (~28 MB); dihasilkan scraper, cadangan di luar repo
backend/data/bytify_database.json
# Hasil panen serial mentah (berisi server alternatif per episode); yang
# diterbitkan adalah series_catalog.json yang sudah diramping.
backend/data/series_database.json
# Berkas sementara penulisan atomik; tertinggal kalau proses panen dimatikan.
backend/data/series_database.json.*.tmp
backend/data/anime_database.json
backend/data/anime_database.json.*.tmp
backend/data/watch_database.json
# Perantara pencocokan judul -> TMDB id. Aliasnya ikut terbit di
# watch_catalog.json, jadi berkas mentahnya tidak perlu dilacak.
backend/data/tmdb_match.json
backend/data/tmdb_match.json.*tmp
backend/data/tmdb_match_worklist.json
# Dataset pemetaan anime (unduhan pihak ketiga) + turunannya.
backend/data/anime_tmdb_source.json
backend/data/anime_tmdb_source.json.*tmp
backend/data/anime_tmdb_worklist.json
backend/data/anime_titles.json
backend/data/anime_titles.json.*tmp
backend/data/anime_tmdb_map.json
backend/data/anime_tmdb_map.json.*
backend/data/watch_database.json.*tmp

# Kunci rilis: JANGAN di-commit, simpan cadangannya di tempat aman
keystore/
keystore.properties

# Private provider URLs and rights configuration for the Live TV backend
backend/live-api/.env

# Cache runtime API LK21 (ditulis ulang tiap jalan; bukan sumber kebenaran)
backend/api/data/lk21-cache.json

# Catatan jalannya daemon auto-sync (dibuat ulang tiap kali jalan)
backend/scraper/auto-sync.log

# Kunci proses & log scrape metadata (lokal, bukan sumber kebenaran)
backend/data/.build_database.lock
backend/scraper/scrape-metadata.log


# Hasil panen katalog film Indonesia (mentah); yang diterbitkan nanti versi
# rampingnya, sama seperti serial.
backend/data/film_indonesia_database.json
backend/data/film_indonesia_database.json.*.tmp

# Kunci API TMDB dan rahasia scraper lain.
backend/api/.env
backend/api/.env.*
!backend/api/.env.example
backend/scraper/.env
backend/scraper/.env.*

# Katalog uji sementara untuk mencoba sumber pemutar baru.
backend/api/dist-uji/
