PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Ganti PUBLIC_BASE_URL sesuai alamat yang diakses HP/Emulator:
# - Emulator Android Studio: http://10.0.2.2:8787
# - HP Fisik (Wi-Fi sama): http://192.168.1.XX:8787
PUBLIC_BASE_URL=http://10.0.2.2:8787

# ---------- Film & serial ----------
MOVIE_PROVIDERS=lk21;archive
MOVIE_REFRESH_SECONDS=21600
ARCHIVE_MAX_MOVIES=40
ARCHIVE_MAX_SERIES=15
ARCHIVE_MAX_YEAR=1977

# ---------- Konfigurasi LK21 & NontonDrama ----------
LK21_URL=https://d21.team
ND_URL=https://d21.team
DL_URL=https://d21.team
LK21_MAX_PAGES=2
LK21_TIMEOUT_MS=15000
CACHE_FILE=./data/lk21-cache.json

# ---------- Live TV ----------
LIVE_PLAYLIST_URLS=https://iptv-org.github.io/iptv/index.m3u
LIVE_SOURCE_RIGHTS_CONFIRMED=true
LIVE_SOURCE_LICENSE_LABEL=Free & Open Source CC0 (GitHub iptv-org Project)
LIVE_SOURCE_REFRESH_SECONDS=300
LIVE_HEALTH_CHECK_SECONDS=120
LIVE_PROBE_TIMEOUT_MS=5000
LIVE_PROBE_CONCURRENCY=10
LIVE_MAX_CHANNELS=120
LIVE_DEFAULT_COUNTRY=ID