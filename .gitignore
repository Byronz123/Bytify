.gradle/
build/
app/build/
backend/api/dist/
local.properties
.idea/
*.iml
.kotlin/

# Python bytecode cache
__pycache__/
*.pyc

# Hasil scraping mentah (~28 MB); dihasilkan scraper, cadangan di luar repo
backend/data/bytify_database.json
# Hasil panen serial mentah (berisi server alternatif per episode); yang
# diterbitkan adalah series_catalog.json yang sudah diramping.
backend/data/series_database.json

# Kunci rilis: JANGAN di-commit, simpan cadangannya di tempat aman
keystore/
keystore.properties

# Private provider URLs and rights configuration for the Live TV backend
backend/live-api/.env

# Cache runtime API LK21 (ditulis ulang tiap jalan; bukan sumber kebenaran)
backend/api/data/lk21-cache.json

# Catatan jalannya daemon auto-sync (dibuat ulang tiap kali jalan)
backend/scraper/auto-sync.log

# Kunci proses & log scrape metadata (lokal, bukan sumber kebenaran)
backend/data/.build_database.lock
backend/scraper/scrape-metadata.log
